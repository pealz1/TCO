----------------------------------------------------------------------
-- BMP Parser Module
----------------------------------------------------------------------
do
    local BMP = {}

    local BMPImage = {}
    BMPImage.__index = BMPImage

    function BMPImage:GetPixel(x, y)
        -- x, y are 1-based pixel coordinates
        local row = self.Bitmap[y]
        if not row then
            return Color3.new(0, 0, 0), 0
        end

        local bpp = self.BytesPerPixel
        local offset = (x - 1) * bpp + 1

        if bpp == 3 then
            local r, g, b = string.byte(row, offset, offset + 2)
            return Color3.new(r / 255, g / 255, b / 255), 255
        else -- bpp == 4
            local r, g, b, a = string.byte(row, offset, offset + 3)
            return Color3.new(r / 255, g / 255, b / 255), a
        end
    end

    function BMP.new(buffer)
        local reader = PNG.BinaryReader.new(buffer)

        -- BITMAPFILEHEADER (14 bytes)
        local sig = reader:ReadBytes(2)
        if sig ~= "BM" then
            error("Not a valid BMP file: bad signature")
        end

        local fileSize = reader:ReadUInt32LE()
        local reserved1 = reader:ReadUInt16LE()
        local reserved2 = reader:ReadUInt16LE()
        local pixelOffset = reader:ReadUInt32LE()

        -- BITMAPINFOHEADER (40 bytes)
        local headerSize = reader:ReadUInt32LE()
        local width = reader:ReadUInt32LE()
        local heightRaw = reader:ReadUInt32LE()

        -- Height can be signed (top-down if negative). Handle via two's complement.
        local topDown = false
        local height = heightRaw
        if height >= 2147483648 then
            -- Negative height in unsigned 32-bit means top-down
            height = 4294967296 - height
            topDown = true
        end

        local planes = reader:ReadUInt16LE()
        local bitsPerPixel = reader:ReadUInt16LE()
        local compression = reader:ReadUInt32LE()
        local imageSize = reader:ReadUInt32LE()
        local xPPM = reader:ReadUInt32LE()
        local yPPM = reader:ReadUInt32LE()
        local colorsUsed = reader:ReadUInt32LE()
        local colorsImportant = reader:ReadUInt32LE()

        if compression ~= 0 then
            error("Only uncompressed BMP is supported (compression=" .. compression .. ")")
        end

        if bitsPerPixel ~= 24 and bitsPerPixel ~= 32 then
            error("Only 24-bit and 32-bit BMP supported (got " .. bitsPerPixel .. "bpp)")
        end

        local bytesPerPixel = bitsPerPixel / 8
        local rowStride = math.floor((bitsPerPixel * width + 31) / 32) * 4

        -- Build bitmap rows: convert BGR(A) to RGB(A), flip to top-down order
        local bitmap = {}

        for row = 0, height - 1 do
            -- Determine which file row to read
            local fileRow
            if topDown then
                fileRow = row
            else
                fileRow = height - 1 - row
            end

            reader:Seek(pixelOffset + fileRow * rowStride + 1) -- +1 for 1-based positioning

            local pixels = {}
            for col = 0, width - 1 do
                local b = reader:ReadByte()
                local g = reader:ReadByte()
                local r = reader:ReadByte()

                pixels[#pixels + 1] = string.char(r, g, b)

                if bytesPerPixel == 4 then
                    local a = reader:ReadByte()
                    pixels[#pixels] = string.char(r, g, b, a)
                end
            end

            bitmap[row + 1] = table.concat(pixels)
        end

        local image = setmetatable({}, BMPImage)
        image.Width = width
        image.Height = height
        image.BitDepth = 8
        image.BytesPerPixel = bytesPerPixel
        image.Bitmap = bitmap

        if bytesPerPixel == 3 then
            image.ColorType = 2  -- RGB, matches PNG truecolor
        else
            image.ColorType = 6  -- RGBA, matches PNG truecolor+alpha
        end

        return image
    end

    PNG.BMP = BMP
end

----------------------------------------------------------------------
-- Image Resampling Module
----------------------------------------------------------------------
do
    local Resample = {}

    function Resample.Nearest(file, x, y)
        local cx = math.clamp(x, 1, file.Width)
        local cy = math.clamp(y, 1, file.Height)
        return file:GetPixel(cx, cy)
    end

    function Resample.Average(file, x1, y1, x2, y2)
        -- Clamp all coordinates
        x1 = math.clamp(x1, 1, file.Width)
        x2 = math.clamp(x2, 1, file.Width)
        y1 = math.clamp(y1, 1, file.Height)
        y2 = math.clamp(y2, 1, file.Height)

        -- Ensure proper ordering
        if x1 > x2 then x1, x2 = x2, x1 end
        if y1 > y2 then y1, y2 = y2, y1 end

        local rSum, gSum, bSum, aSum = 0, 0, 0, 0
        local count = 0

        for py = y1, y2 do
            for px = x1, x2 do
                local color, alpha = file:GetPixel(px, py)
                rSum = rSum + color.R
                gSum = gSum + color.G
                bSum = bSum + color.B
                aSum = aSum + alpha
                count = count + 1
            end
        end

        if count == 0 then
            return Color3.new(0, 0, 0), 0
        end

        return Color3.new(rSum / count, gSum / count, bSum / count), math.floor(aSum / count + 0.5)
    end

    function Resample.Bilinear(file, fx, fy)
        -- fx, fy are 1-based floating point coordinates
        local x0 = math.floor(fx)
        local y0 = math.floor(fy)
        local x1 = x0 + 1
        local y1 = y0 + 1

        local xFrac = fx - x0
        local yFrac = fy - y0

        -- Clamp to image bounds
        x0 = math.clamp(x0, 1, file.Width)
        x1 = math.clamp(x1, 1, file.Width)
        y0 = math.clamp(y0, 1, file.Height)
        y1 = math.clamp(y1, 1, file.Height)

        local c00, a00 = file:GetPixel(x0, y0)
        local c10, a10 = file:GetPixel(x1, y0)
        local c01, a01 = file:GetPixel(x0, y1)
        local c11, a11 = file:GetPixel(x1, y1)

        local invX = 1 - xFrac
        local invY = 1 - yFrac

        local r = (c00.R * invX + c10.R * xFrac) * invY + (c01.R * invX + c11.R * xFrac) * yFrac
        local g = (c00.G * invX + c10.G * xFrac) * invY + (c01.G * invX + c11.G * xFrac) * yFrac
        local b = (c00.B * invX + c10.B * xFrac) * invY + (c01.B * invX + c11.B * xFrac) * yFrac
        local a = (a00 * invX + a10 * xFrac) * invY + (a01 * invX + a11 * xFrac) * yFrac

        return Color3.new(
            math.clamp(r, 0, 1),
            math.clamp(g, 0, 1),
            math.clamp(b, 0, 1)
        ), math.floor(math.clamp(a, 0, 255) + 0.5)
    end

    PNG.Resample = Resample
end

----------------------------------------------------------------------
-- Image Resize Function
----------------------------------------------------------------------
do
    local ResizedImage = {}
    ResizedImage.__index = ResizedImage

    function ResizedImage:GetPixel(x, y)
        -- Map from resized coordinates back to original image coordinates
        -- Formula: floor((x - 0.5) * scaleInv) + 1  (center-to-center nearest neighbor)
        local srcX = math.clamp(math.floor((x - 0.5) * self._scaleInv) + 1, 1, self._source.Width)
        local srcY = math.clamp(math.floor((y - 0.5) * self._scaleInv) + 1, 1, self._source.Height)
        return self._source:GetPixel(srcX, srcY)
    end

    function PNG.Resize(file, scalePct)
        local scale = scalePct / 100
        local newWidth = math.max(1, math.floor(file.Width * scale + 0.5))
        local newHeight = math.max(1, math.floor(file.Height * scale + 0.5))

        local resized = setmetatable({}, ResizedImage)
        resized.Width = newWidth
        resized.Height = newHeight
        resized.ColorType = file.ColorType
        resized.BitDepth = file.BitDepth
        resized.BytesPerPixel = file.BytesPerPixel
        resized._source = file
        resized._scaleInv = 1 / scale
        return resized
    end
end

----------------------------------------------------------------------
-- File Type Detection
----------------------------------------------------------------------
do
    function PNG.DetectFileType(data)
        if #data < 4 then
            return "unknown"
        end

        local b1, b2, b3, b4 = string.byte(data, 1, 4)

        -- PNG: 137 80 78 71 (0x89 P N G)
        if b1 == 137 and b2 == 80 and b3 == 78 and b4 == 71 then
            return "png"
        end

        -- BMP: "BM"
        if b1 == 66 and b2 == 77 then
            return "bmp"
        end

        -- JPEG: FF D8 FF
        if b1 == 255 and b2 == 216 and b3 == 255 then
            return "jpeg"
        end

        -- GIF: "GIF8"
        if b1 == 71 and b2 == 73 and b3 == 70 and b4 == 56 then
            return "gif"
        end

        -- WebP: "RIFF" + offset 8 "WEBP"
        if b1 == 82 and b2 == 73 and b3 == 70 and b4 == 70 and #data >= 12 then
            local w1, w2, w3, w4 = string.byte(data, 9, 12)
            if w1 == 87 and w2 == 69 and w3 == 66 and w4 == 80 then
                return "webp"
            end
        end

        return "unknown"
    end
end

----------------------------------------------------------------------
-- Brightness Utility
----------------------------------------------------------------------
do
    function PNG.GetBrightness(color)
        return 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
    end
end

----------------------------------------------------------------------
-- Dither Module
----------------------------------------------------------------------
do
    local Dither = {}

    function Dither.FloydSteinberg(file, canvasW, canvasH, pixelSize, sampleFunc)
        -- Pre-compute a Floyd-Steinberg dithered color grid.
        -- Returns grid[cy][cx] = Color3
        -- sampleFunc signature: sampleFunc(file, cx, cy, pixelSize) -> Color3, alpha

        -- First, sample all colors into floating-point RGB arrays
        local rGrid = {}
        local gGrid = {}
        local bGrid = {}

        for cy = 1, canvasH do
            rGrid[cy] = {}
            gGrid[cy] = {}
            bGrid[cy] = {}
            for cx = 1, canvasW do
                local color, alpha = sampleFunc(file, cx, cy, pixelSize)
                rGrid[cy][cx] = color.R
                gGrid[cy][cx] = color.G
                bGrid[cy][cx] = color.B
            end
        end

        -- Quantize to nearest palette value (simple round to 0 or 1 per channel,
        -- or more generally snap to nearest 1/255 step) and diffuse error
        local grid = {}
        for cy = 1, canvasH do
            grid[cy] = {}
            for cx = 1, canvasW do
                local oldR = rGrid[cy][cx]
                local oldG = gGrid[cy][cx]
                local oldB = bGrid[cy][cx]

                -- Quantize: snap to nearest value in [0, 1] representable by 8-bit
                local newR = math.floor(oldR * 255 + 0.5) / 255
                local newG = math.floor(oldG * 255 + 0.5) / 255
                local newB = math.floor(oldB * 255 + 0.5) / 255

                newR = math.clamp(newR, 0, 1)
                newG = math.clamp(newG, 0, 1)
                newB = math.clamp(newB, 0, 1)

                grid[cy][cx] = Color3.new(newR, newG, newB)

                local errR = oldR - newR
                local errG = oldG - newG
                local errB = oldB - newB

                -- Distribute error to neighbors: right, bottom-left, bottom, bottom-right
                -- Weights: 7/16, 3/16, 5/16, 1/16
                if cx + 1 <= canvasW then
                    rGrid[cy][cx + 1] = rGrid[cy][cx + 1] + errR * (7 / 16)
                    gGrid[cy][cx + 1] = gGrid[cy][cx + 1] + errG * (7 / 16)
                    bGrid[cy][cx + 1] = bGrid[cy][cx + 1] + errB * (7 / 16)
                end
                if cy + 1 <= canvasH then
                    if cx - 1 >= 1 then
                        rGrid[cy + 1][cx - 1] = rGrid[cy + 1][cx - 1] + errR * (3 / 16)
                        gGrid[cy + 1][cx - 1] = gGrid[cy + 1][cx - 1] + errG * (3 / 16)
                        bGrid[cy + 1][cx - 1] = bGrid[cy + 1][cx - 1] + errB * (3 / 16)
                    end
                    rGrid[cy + 1][cx] = rGrid[cy + 1][cx] + errR * (5 / 16)
                    gGrid[cy + 1][cx] = gGrid[cy + 1][cx] + errG * (5 / 16)
                    bGrid[cy + 1][cx] = bGrid[cy + 1][cx] + errB * (5 / 16)
                    if cx + 1 <= canvasW then
                        rGrid[cy + 1][cx + 1] = rGrid[cy + 1][cx + 1] + errR * (1 / 16)
                        gGrid[cy + 1][cx + 1] = gGrid[cy + 1][cx + 1] + errG * (1 / 16)
                        bGrid[cy + 1][cx + 1] = bGrid[cy + 1][cx + 1] + errB * (1 / 16)
                    end
                end
            end
        end

        return grid
    end

    -- Pre-computed Bayer matrices
    local bayerMatrices = {}

    bayerMatrices[2] = {
        {0, 2},
        {3, 1},
    }

    bayerMatrices[4] = {
        { 0,  8,  2, 10},
        {12,  4, 14,  6},
        { 3, 11,  1,  9},
        {15,  7, 13,  5},
    }

    bayerMatrices[8] = {
        { 0, 32,  8, 40,  2, 34, 10, 42},
        {48, 16, 56, 24, 50, 18, 58, 26},
        {12, 44,  4, 36, 14, 46,  6, 38},
        {60, 28, 52, 20, 62, 30, 54, 22},
        { 3, 35, 11, 43,  1, 33,  9, 41},
        {51, 19, 59, 27, 49, 17, 57, 25},
        {15, 47,  7, 39, 13, 45,  5, 37},
        {63, 31, 55, 23, 61, 29, 53, 21},
    }

    function Dither.Ordered(color, x, y, matrixSize)
        local matrix = bayerMatrices[matrixSize]
        if not matrix then
            error("Ordered dither matrixSize must be 2, 4, or 8, got: " .. tostring(matrixSize))
        end

        local n = matrixSize
        local n2 = n * n
        -- Map x, y to matrix indices (0-based, wrapping)
        local mx = (x - 1) % n + 1
        local my = (y - 1) % n + 1
        local threshold = (matrix[my][mx] + 0.5) / n2 - 0.5 -- range [-0.5, 0.5)

        local spread = 1 / 255 -- one quantization step for 8-bit
        local r = math.clamp(math.floor((color.R + threshold * spread) * 255 + 0.5) / 255, 0, 1)
        local g = math.clamp(math.floor((color.G + threshold * spread) * 255 + 0.5) / 255, 0, 1)
        local b = math.clamp(math.floor((color.B + threshold * spread) * 255 + 0.5) / 255, 0, 1)

        return Color3.new(r, g, b)
    end

    PNG.Dither = Dither
end

----------------------------------------------------------------------
-- Edge Detection Module
----------------------------------------------------------------------
do
    local EdgeDetect = {}

    -- Sobel kernels
    local sobelX = {
        {-1, 0, 1},
        {-2, 0, 2},
        {-1, 0, 1},
    }

    local sobelY = {
        {-1, -2, -1},
        { 0,  0,  0},
        { 1,  2,  1},
    }

    function EdgeDetect.Sobel(file, x, y)
        -- Applies Sobel edge detection at pixel (x, y).
        -- Returns magnitude in range [0, 1].
        local gx = 0
        local gy = 0

        for ky = -1, 1 do
            for kx = -1, 1 do
                local px = math.clamp(x + kx, 1, file.Width)
                local py = math.clamp(y + ky, 1, file.Height)
                local color = file:GetPixel(px, py)
                local brightness = 0.299 * color.R + 0.587 * color.G + 0.114 * color.B

                local ki = ky + 2 -- 1-based index
                local kj = kx + 2
                gx = gx + brightness * sobelX[ki][kj]
                gy = gy + brightness * sobelY[ki][kj]
            end
        end

        local magnitude = math.sqrt(gx * gx + gy * gy)
        -- Normalize: theoretical max for Sobel on [0,1] brightness is ~4.0
        -- Clamp to [0, 1]
        return math.clamp(magnitude, 0, 1)
    end

    PNG.EdgeDetect = EdgeDetect
end

----------------------------------------------------------------------
-- Color Effect Module
----------------------------------------------------------------------
do
    local ColorEffect = {}

    function ColorEffect.Grayscale(color)
        local gray = 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
        return Color3.new(gray, gray, gray)
    end

    function ColorEffect.Sepia(color)
        local r = color.R
        local g = color.G
        local b = color.B

        local newR = math.clamp(r * 0.393 + g * 0.769 + b * 0.189, 0, 1)
        local newG = math.clamp(r * 0.349 + g * 0.686 + b * 0.168, 0, 1)
        local newB = math.clamp(r * 0.272 + g * 0.534 + b * 0.131, 0, 1)

        return Color3.new(newR, newG, newB)
    end

    function ColorEffect.Invert(color)
        return Color3.new(1 - color.R, 1 - color.G, 1 - color.B)
    end

    function ColorEffect.Posterize(color, levels)
        levels = math.clamp(levels or 4, 2, 16)
        local divisor = levels - 1

        local r = math.floor(color.R * divisor + 0.5) / divisor
        local g = math.floor(color.G * divisor + 0.5) / divisor
        local b = math.floor(color.B * divisor + 0.5) / divisor

        return Color3.new(
            math.clamp(r, 0, 1),
            math.clamp(g, 0, 1),
            math.clamp(b, 0, 1)
        )
    end

    function ColorEffect.Contrast(color, amount)
        -- amount: 0-2 where 1 is no change
        amount = amount or 1
        local r = math.clamp((color.R - 0.5) * amount + 0.5, 0, 1)
        local g = math.clamp((color.G - 0.5) * amount + 0.5, 0, 1)
        local b = math.clamp((color.B - 0.5) * amount + 0.5, 0, 1)
        return Color3.new(r, g, b)
    end

    function ColorEffect.Saturate(color, amount)
        -- amount: 0-2 where 1 is no change, 0 is grayscale, 2 is double saturation
        amount = amount or 1
        local gray = 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
        local r = math.clamp(gray + (color.R - gray) * amount, 0, 1)
        local g = math.clamp(gray + (color.G - gray) * amount, 0, 1)
        local b = math.clamp(gray + (color.B - gray) * amount, 0, 1)
        return Color3.new(r, g, b)
    end

    function ColorEffect.Neon(color)
        -- Boost saturation and brightness for a neon glow effect
        local gray = 0.299 * color.R + 0.587 * color.G + 0.114 * color.B

        -- Boost saturation by 2x
        local r = gray + (color.R - gray) * 2
        local g = gray + (color.G - gray) * 2
        local b = gray + (color.B - gray) * 2

        -- Boost brightness by 1.5x
        r = r * 1.5
        g = g * 1.5
        b = b * 1.5

        return Color3.new(
            math.clamp(r, 0, 1),
            math.clamp(g, 0, 1),
            math.clamp(b, 0, 1)
        )
    end

    function ColorEffect.Apply(color, effectName, params)
        params = params or {}
        local name = string.lower(effectName)

        if name == "grayscale" then
            return ColorEffect.Grayscale(color)
        elseif name == "sepia" then
            return ColorEffect.Sepia(color)
        elseif name == "invert" then
            return ColorEffect.Invert(color)
        elseif name == "posterize" then
            return ColorEffect.Posterize(color, params.levels or params[1])
        elseif name == "contrast" then
            return ColorEffect.Contrast(color, params.amount or params[1])
        elseif name == "saturate" or name == "saturation" then
            return ColorEffect.Saturate(color, params.amount or params[1])
        elseif name == "neon" then
            return ColorEffect.Neon(color)
        else
            error("Unknown color effect: " .. tostring(effectName))
        end
    end

    PNG.ColorEffect = ColorEffect
end

----------------------------------------------------------------------
-- Gradient Map Module
----------------------------------------------------------------------
do
    local GradientMap = {}

    -- Each gradient is an array of {position, Color3} stops sorted by position (0 to 1)
    local gradients = {}

    gradients["sunset"] = {
        {0.0,  Color3.new(0.2, 0.0, 0.3)},   -- dark purple
        {0.4,  Color3.new(0.9, 0.3, 0.1)},   -- orange
        {1.0,  Color3.new(1.0, 0.9, 0.2)},   -- yellow
    }

    gradients["ocean"] = {
        {0.0,  Color3.new(0.0, 0.1, 0.4)},   -- deep blue
        {0.5,  Color3.new(0.0, 0.7, 0.8)},   -- cyan
        {1.0,  Color3.new(1.0, 1.0, 1.0)},   -- white
    }

    gradients["forest"] = {
        {0.0,  Color3.new(0.0, 0.2, 0.0)},   -- dark green
        {0.5,  Color3.new(0.3, 0.8, 0.1)},   -- lime
        {1.0,  Color3.new(0.9, 0.9, 0.2)},   -- yellow
    }

    gradients["infrared"] = {
        {0.0,  Color3.new(0.0, 0.0, 0.0)},   -- black
        {0.2,  Color3.new(0.4, 0.0, 0.5)},   -- purple
        {0.4,  Color3.new(0.8, 0.0, 0.1)},   -- red
        {0.6,  Color3.new(1.0, 0.5, 0.0)},   -- orange
        {0.8,  Color3.new(1.0, 0.9, 0.0)},   -- yellow
        {1.0,  Color3.new(1.0, 1.0, 1.0)},   -- white
    }

    gradients["rainbow"] = {
        {0.0,      Color3.new(1.0, 0.0, 0.0)},   -- red
        {1 / 6,    Color3.new(1.0, 1.0, 0.0)},   -- yellow
        {2 / 6,    Color3.new(0.0, 1.0, 0.0)},   -- green
        {3 / 6,    Color3.new(0.0, 1.0, 1.0)},   -- cyan
        {4 / 6,    Color3.new(0.0, 0.0, 1.0)},   -- blue
        {5 / 6,    Color3.new(1.0, 0.0, 1.0)},   -- magenta
        {1.0,      Color3.new(1.0, 0.0, 0.0)},   -- red (wrap)
    }

    gradients["fire"] = {
        {0.0,  Color3.new(0.0, 0.0, 0.0)},   -- black
        {0.25, Color3.new(0.5, 0.0, 0.0)},   -- dark red
        {0.5,  Color3.new(1.0, 0.3, 0.0)},   -- orange
        {0.75, Color3.new(1.0, 0.7, 0.0)},   -- yellow-orange
        {1.0,  Color3.new(1.0, 1.0, 0.8)},   -- bright yellow-white
    }

    gradients["ice"] = {
        {0.0,  Color3.new(0.05, 0.05, 0.3)}, -- dark blue
        {0.5,  Color3.new(0.9, 0.95, 1.0)},  -- white
        {1.0,  Color3.new(0.3, 0.9, 1.0)},   -- cyan
    }

    local function sampleGradient(stops, t)
        t = math.clamp(t, 0, 1)

        -- Find the two stops surrounding t
        if t <= stops[1][1] then
            local c = stops[1][2]
            return Color3.new(c.R, c.G, c.B)
        end

        for i = 2, #stops do
            if t <= stops[i][1] then
                local prev = stops[i - 1]
                local curr = stops[i]
                local range = curr[1] - prev[1]
                local frac = 0
                if range > 0 then
                    frac = (t - prev[1]) / range
                end
                local pc = prev[2]
                local cc = curr[2]
                return Color3.new(
                    pc.R + (cc.R - pc.R) * frac,
                    pc.G + (cc.G - pc.G) * frac,
                    pc.B + (cc.B - pc.B) * frac
                )
            end
        end

        -- Past the last stop
        local c = stops[#stops][2]
        return Color3.new(c.R, c.G, c.B)
    end

    function GradientMap.Apply(color, gradientName)
        local name = string.lower(gradientName)
        local stops = gradients[name]
        if not stops then
            error("Unknown gradient: " .. tostring(gradientName) .. ". Available: sunset, ocean, forest, infrared, rainbow, fire, ice")
        end

        -- Map brightness to gradient
        local brightness = 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
        return sampleGradient(stops, brightness)
    end

    PNG.GradientMap = GradientMap
end

----------------------------------------------------------------------
-- Batch Pixel Access
----------------------------------------------------------------------
do
    function PNG.BatchGetPixels(file, x1, y1, x2, y2)
        -- Returns a 2D array: result[y][x] = {color, alpha}
        -- More efficient than calling GetPixel in a loop due to
        -- reduced function call overhead with local caching.
        local getPixel = file.GetPixel
        local result = {}

        for y = y1, y2 do
            local row = {}
            for x = x1, x2 do
                local color, alpha = getPixel(file, x, y)
                row[x - x1 + 1] = {color, alpha}
            end
            result[y - y1 + 1] = row
        end

        return result
    end
end

----------------------------------------------------------------------
-- Mirror Utility
----------------------------------------------------------------------
do
    function PNG.MirrorCoords(x, y, width, height, mode)
        -- Remaps coordinates for mirror modes.
        -- mode: "horizontal", "vertical", "both"
        -- Returns remapped x, y (1-based coordinates)
        local newX = x
        local newY = y

        if mode == "horizontal" or mode == "both" then
            newX = width - x + 1
        end

        if mode == "vertical" or mode == "both" then
            newY = height - y + 1
        end

        return newX, newY
    end
end

